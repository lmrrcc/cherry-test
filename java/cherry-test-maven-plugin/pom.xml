<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.cherrytest</groupId>
    <artifactId>cherry-test-parent</artifactId>
    <version>0.3.16</version>
  </parent>

  <artifactId>cherry-test-maven-plugin</artifactId>
  <packaging>maven-plugin</packaging>
  <name>cherry-test-maven-plugin</name>
  <description>Runs Cherry Test from Maven: ./mvnw cherry-test:run, the Java counterpart of cargo cherry-test.</description>

  <properties>
    <maven-api.version>3.9.16</maven-api.version>
    <maven-plugin-tools.version>3.16.0</maven-plugin-tools.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.cherrytest</groupId>
      <artifactId>cherry-test-cli</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-plugin-api</artifactId>
      <version>${maven-api.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.plugin-tools</groupId>
      <artifactId>maven-plugin-annotations</artifactId>
      <version>${maven-plugin-tools.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-plugin-plugin</artifactId>
        <version>${maven-plugin-tools.version}</version>
        <configuration>
          <goalPrefix>cherry-test</goalPrefix>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
